# Token dari @BotFather di Telegram
BOT_TOKEN=8727511551:AAGEPyeZGlnMw_lcS86g-3w_tlivYi_ERdQ

# Database (SQLite untuk lokal, ganti ke PostgreSQL untuk produksi)
DATABASE_URL=sqlite:///PanganKita.db

# ── LLM Backend ────────────────────────────────────────────────────────────────
# Pilih: ollama | openai_compatible | llamacpp
LLM_BACKEND=ollama

# Opsi 1: Ollama — bisa load model fine-tuning via Modelfile:
#   echo "FROM /path/to/model.gguf" > Modelfile && ollama create mymodel -f Modelfile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Opsi 2: OpenAI-Compatible (vLLM / llama.cpp server / LM Studio)
# LLM_BACKEND=openai_compatible
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_API_KEY=none
# OPENAI_MODEL=nama-model

# Opsi 3: llama-cpp-python langsung (pip install llama-cpp-python)
# LLM_BACKEND=llamacpp
# MODEL_PATH=/path/to/fine-tuned-model.gguf

# Telegram ID admin (pisahkan dengan koma jika lebih dari satu)
ADMIN_IDS=
